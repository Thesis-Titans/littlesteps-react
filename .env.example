# Points the React web client to the Express REST API (local emulator or Cloud Functions)
VITE_API_BASE_URL=http://127.0.0.1:5001/demo-littlesteps/asia-southeast1/api

# Connects Firebase Web Auth to the local Auth emulator on port 9099 when set to true
VITE_USE_FIREBASE_EMULATOR=true

# Public Firebase Web SDK configuration (never place server secrets in VITE_* variables)
VITE_FIREBASE_PROJECT_ID=demo-littlesteps
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_APP_ID=
